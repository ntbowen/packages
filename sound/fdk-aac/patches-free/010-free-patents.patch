-      /* Setup CRC decoder */
-      FDKcrcInit(&crcInfo, crcPoly, crcStartValue, crcLen);
-      /* Start CRC region */
-      crcReg = FDKcrcStartReg(&crcInfo, hBs, 0);
-    }
-  } /* if (fDoDecodeSbrData) */
-
