-      int sbrInfoPresent;
-
-      if (bs_interTes) {
-        self->flags |= SBRDEC_USAC_ITES;
-      } else {
-        self->flags &= ~SBRDEC_USAC_ITES;
-      }
-
-      if (fGlobalIndependencyFlag) {
-        self->flags |= SBRDEC_USAC_INDEP;
