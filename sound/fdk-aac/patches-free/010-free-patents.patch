-  int stereo = (hSbrElement->elementID == ID_CPE) ? 1 : 0;
-  int numElementChannels =
-      hSbrElement
-          ->nChannels; /* Number of channels of the current SBR element */
-
-  hFrameDataLeft =
-      &hSbrElement->pSbrChannel[0]->frameData[hSbrElement->useFrameSlot];
-  if (stereo) {
