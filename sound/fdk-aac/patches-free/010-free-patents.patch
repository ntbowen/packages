-  switch (pvcMode) {
-    case 0:
-      /* legacy SBR, nothing to do */
-      return 0;
-    case 1:
-      pPvcDynamicData->nbHigh = 8;
-      pPvcDynamicData->pPVCTab1 = (const UCHAR *)g_3a_pvcTab1_mode1;
-      pPvcDynamicData->pPVCTab2 = (const UCHAR *)g_2a_pvcTab2_mode1;
