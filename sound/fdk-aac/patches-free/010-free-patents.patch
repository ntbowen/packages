-        hSbrHeader->syncState = hSbrHeader->syncState > UPSAMPLING
-                                    ? UPSAMPLING
-                                    : hSbrHeader->syncState;
-        fDoDecodeSbrData = 0;
-        sbrHeaderPresent = 0;
