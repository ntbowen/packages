+-    CAacDecoderStaticChannelInfo *pAacDecoderStaticChannelInfo,
+-    const int samplesPerFrame, CAacDecoderChannelInfo *pAacDecoderChannelInfo);
+-
+-static int CConcealment_TDNoise_Random(ULONG *seed);
