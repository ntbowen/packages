-                               hFrameData->sbrPatchingMode,
-                               GetxOverBandQmfTransposer(hSbrDec->hHBE),
-                               Get41SbrQmfTransposer(hSbrDec->hHBE));
-
-  hSbrDec->SbrCalculateEnvelope.sbrPatchingMode = hFrameData->sbrPatchingMode;
-
-  return sbrError;
-}
