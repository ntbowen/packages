-
- Description:
-
- Arguments:  INT* frameClass, INT* frameClassOld, INT tranFlag, INT* spreadFlag)
-
- Return:      none
-
-*******************************************************************************/
-static void calcFrameClass(FRAME_CLASS *frameClass, FRAME_CLASS *frameClassOld,
