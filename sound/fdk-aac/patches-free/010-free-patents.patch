+#define PS_IS_EXPLICITLY_DISABLED(aot, flags) \
+  (((aot) == AOT_DRM_AAC) && !(flags & AC_PS_PRESENT))
+
+#define IS_STEREO_SBR(el_id, stereoConfigIndex)            \
+  (((el_id) == ID_USAC_CPE && (stereoConfigIndex) == 0) || \
+   ((el_id) == ID_USAC_CPE && (stereoConfigIndex) == 3))
