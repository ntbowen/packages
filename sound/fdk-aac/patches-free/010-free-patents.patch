-  pPvcDynamicData->pvcBorder0 = pvcBorder0;
-  UCHAR pvcBorder0_last = pPvcStaticData->pvcBorder0;
-  pPvcStaticData->pvcBorder0 = pvcBorder0;
-  pPvcDynamicData->pPvcID = pPvcID;
-
-  pPvcDynamicData->ns = ns;
