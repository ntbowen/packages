-void CLpd_AcelpDecode(CAcelpStaticMem *acelp_mem, INT i_offset,
-                      const FIXP_LPC lsp_old[M_LP_FILTER_ORDER],
-                      const FIXP_LPC lsp_new[M_LP_FILTER_ORDER],
