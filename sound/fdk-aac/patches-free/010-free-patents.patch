-static SCHAR get_next_lav_step(const INT lav, const DATA_TYPE data_type) {
-  SCHAR lav_step = 0;
-
-  switch (data_type) {
-    case t_CLD:
-      lav_step = (lav > 9) ? -1 : lav_step_CLD[lav];
-      break;
-    case t_ICC:
-      lav_step = (lav > 7) ? -1 : lav_step_ICC[lav];
-      break;
-  }
-
-  return lav_step;
-}
