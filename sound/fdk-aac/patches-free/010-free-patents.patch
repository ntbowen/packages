-        *frameClass = FIXFIX;
-      break;
-    case VARVAR:
-      if (tranFlag) {
-        *frameClass = VARVAR;
-        *spreadFlag = 0;
-      } else {
-        if (*spreadFlag)
-          *frameClass = VARVAR;
-        else
-          *frameClass = VARFIX;
-      }
-      break;
