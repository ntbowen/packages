-    if (d == 1) { /*  stretch one slot */
-      *length_v_bord = L - 1;
-      *length_v_freq = L - 1;
-    } else {
-      if ((v_bord[L - 1] - v_bord[L - 2]) > 2) { /* compress one quant step */
-        v_bord[L - 1] = v_bord[L - 1] - 2;
-        v_freq[*length_v_freq - 1] = 0; /* use low res for short segment */
-      }
-    }
-  }
