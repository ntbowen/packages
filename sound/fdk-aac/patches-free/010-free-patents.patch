-    case 2:
-      pPvcDynamicData->nbHigh = 6;
-      pPvcDynamicData->pPVCTab1 = (const UCHAR *)g_3a_pvcTab1_mode2;
-      pPvcDynamicData->pPVCTab2 = (const UCHAR *)g_2a_pvcTab2_mode2;
-      pPvcDynamicData->pPVCTab1_dp = g_a_pvcTab1_dp_mode2;
