-    hTtoBox->nParameterBands =
-        getNumberParameterBands(ttoBoxConfig->subbandConfig);
-    hTtoBox->bFrameKeep = ttoBoxConfig->bFrameKeep;
-
-    hTtoBox->nIccQuantSteps =
