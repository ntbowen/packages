-            } else {
-              headerStatus = HEADER_OK;
-            }
-
-            hSbrHeader->bs_info = newSbrInfo;
-          } else {
-            headerStatus = HEADER_OK;
-          }
-        }
-      }
-      if (headerStatus == HEADER_ERROR) {
