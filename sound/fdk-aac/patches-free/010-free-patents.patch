-      ((self->pQmfDomain->globalConf.flags & QMF_FLAG_LP) ? 1 : 0)) {
-    if (self->flags & SBRDEC_LOW_POWER) {
-      self->pQmfDomain->globalConf.flags |= QMF_FLAG_LP;
-      self->pQmfDomain->globalConf.flags_requested |= QMF_FLAG_LP;
-    } else {
-      self->pQmfDomain->globalConf.flags &= ~QMF_FLAG_LP;
-      self->pQmfDomain->globalConf.flags_requested &= ~QMF_FLAG_LP;
-    }
