-    FDKcrcEndReg(&crcInfo, hBs, crcReg); /* End CRC region */
-    FDKpushBack(hBs, alignBits);
-    /* Check CRC */
-    if ((FDKcrcGetCRC(&crcInfo) ^ crcStartValue) != sbrCrc) {
