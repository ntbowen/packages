-
-INT FDKaacEnc_InitDownsampler(
-    DOWNSAMPLER *DownSampler, /*!< pointer to downsampler instance */
-    int Wc,                   /*!< normalized cutoff freq * 1000*  */
-    int ratio)                /*!< downsampler ratio */
-
-{
