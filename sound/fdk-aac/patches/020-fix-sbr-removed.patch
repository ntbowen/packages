-      payloadBits +=
-          FDKwriteBits(hBitStream, sbrHeaderData->sbr_smoothing_length,
-                       SI_SBR_SMOOTHING_LENGTH_BITS);
-
-    } /* sbrHeaderData->header_extra_2 */
-  }   /* sbrHeaderData != NULL */
-
-  return payloadBits;
