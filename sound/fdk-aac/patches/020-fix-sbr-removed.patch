-  INT i;
-
-  for (i = 0; i < *length_v_bord; i++)
-    if (v_bord[i] >= bufferFrameStart + numberTimeSlots) { /* FH 00-06-26 */
-      *i_cmon = i;
-      break;
-    }
-
-  /* keep track of transient: */
-  for (i = 0; i < *length_v_bord; i++)
-    if (v_bord[i] >= tran) {
-      *i_tran = i;
-      break;
