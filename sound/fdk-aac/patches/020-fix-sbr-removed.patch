-/*******************************************************************************
- Functionname:  calcFrameClass
- *******************************************************************************
-
- Description:
-
- Arguments:  INT* frameClass, INT* frameClassOld, INT tranFlag, INT* spreadFlag)
-
- Return:      none
-
-*******************************************************************************/
-static void calcFrameClass(FRAME_CLASS *frameClass, FRAME_CLASS *frameClassOld,
-                           INT tranFlag, INT *spreadFlag) {
-  switch (*frameClassOld) {
-    case FIXFIXonly:
-    case FIXFIX:
-      if (tranFlag)
-        *frameClass = FIXVAR;
-      else
-        *frameClass = FIXFIX;
-      break;
-    case FIXVAR:
-      if (tranFlag) {
-        *frameClass = VARVAR;
-        *spreadFlag = 0;
-      } else {
-        if (*spreadFlag)
-          *frameClass = VARVAR;
-        else
-          *frameClass = VARFIX;
-      }
-      break;
-    case VARFIX:
-      if (tranFlag)
-        *frameClass = FIXVAR;
-      else
-        *frameClass = FIXFIX;
-      break;
-    case VARVAR:
-      if (tranFlag) {
-        *frameClass = VARVAR;
-        *spreadFlag = 0;
-      } else {
-        if (*spreadFlag)
-          *frameClass = VARVAR;
-        else
-          *frameClass = VARFIX;
-      }
-      break;
-  };
-
-  *frameClassOld = *frameClass;
-}
