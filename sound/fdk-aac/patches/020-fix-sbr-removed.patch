-  INT borders[MAX_ENVELOPES + 1];  /*!< envelope borders in SBR timeslots */
-  FREQ_RES freqRes[MAX_ENVELOPES]; /*!< frequency resolution of each envelope */
-  INT shortEnv; /*!< number of an envelope to be shortened (starting at 1) or 0
