-
-  UCHAR sbrPatchingMode;
-  UCHAR sbrOversamplingFlag;
-  UCHAR sbrPitchInBins;
-} SBR_FRAME_DATA;
-
-typedef SBR_FRAME_DATA *HANDLE_SBR_FRAME_DATA;
-
